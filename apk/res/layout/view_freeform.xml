<?xml version="1.0" encoding="utf-8"?>
<!-- Framework-only version of the original layout (no androidx / ConstraintLayout / CardView),
     so this APK needs no code at all and can be built with aapt2 alone.
     Views are looked up by android:tag from FreeformWindow.kt - keep the tags. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:clipToOutline="true">

    <!-- top bar -->
    <LinearLayout
        android:id="@+id/topBarView"
        android:tag="topBarView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/color_background">

        <ImageView
            android:id="@+id/appIcon"
            android:tag="appIcon"
            android:layout_width="24dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/packageName"
            android:tag="packageName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="11sp"
            android:textColor="@color/color_text" />

        <ImageView
            android:id="@+id/pinView"
            android:tag="pinView"
            android:layout_width="24dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_pin" />

        <ImageView
            android:id="@+id/maximizeView"
            android:tag="maximizeView"
            android:layout_width="24dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_maximize" />

        <ImageView
            android:id="@+id/minimizeView"
            android:tag="minimizeView"
            android:layout_width="24dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_minimize" />
    </LinearLayout>

    <!-- content: the TextureView is added to freeform_root by code; veil sits on top -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/freeform_root"
            android:tag="freeform_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:id="@+id/veilView"
            android:tag="veilView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ImageView
                android:id="@+id/veilAppIcon"
                android:tag="veilAppIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center" />
        </FrameLayout>
    </FrameLayout>

    <!-- bottom bar -->
    <FrameLayout
        android:id="@+id/bottomBar"
        android:tag="bottomBarView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_bar_height"
        android:background="@drawable/color_background">

        <LinearLayout
            android:id="@+id/leftScale"
            android:tag="leftScaleView"
            android:layout_width="@dimen/scale_width"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:background="@drawable/bar_corners_bg" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/gesturePillTouchView"
            android:tag="gesturePillTouchView"
            android:layout_width="112dp"
            android:layout_height="match_parent"
            android:layout_gravity="center">

            <View
                android:id="@+id/gesturePillPlate"
                android:tag="gesturePillPlate"
                android:layout_width="84dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:alpha="0" />

            <View
                android:id="@+id/gesturePill"
                android:tag="gesturePill"
                android:layout_width="68dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:alpha="0.72" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/arrowBack"
            android:tag="arrowBack"
            android:layout_width="112dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/ic_arrow_back" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rightScale"
            android:tag="rightScaleView"
            android:layout_width="@dimen/scale_width"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:background="@drawable/bar_corners_bg" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
